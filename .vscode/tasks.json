{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Documents to HTML",
            "type": "shell",
            "command": "../../.conda/bin/python",
            "args": [
                "compile_guide.py"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "./scripts",
                "shell": {}
            },
            "problemMatcher": [
                {
                    "owner": "docutils",
                    "pattern": {
                        "regexp": "^([^:]+):(\\d+): \\((SEVERE|WARNING|INFO|DEBUG)/(\\d+)\\) (.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "label": "Start test server",
            "path": "html",
            "script": "dev",
            "problemMatcher": []
        }
    ]
}